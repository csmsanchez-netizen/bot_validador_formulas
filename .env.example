# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.
DISCORD_TOKEN=pega_aqui_el_token_del_bot
OPENAI_API_KEY=pega_aqui_la_api_key

# Opcionales
# Modelo de OpenAI (debe aceptar imagenes)
OPENAI_MODEL=gpt-4o
# ID del rol de Discord a mencionar cuando el semaforo sea rojo (ej. rol @Calidad)
ROL_CALIDAD_ID=
# ID del canal donde el bot debe responder (vacio = cualquier canal)
CANAL_ID=
